# Configurações de Produção - Hostinger
NODE_ENV=production
PORT=3001

# Firebase
FIREBASE_PROJECT_ID=seu_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nsua_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=seu_client_email@seu_project_id.iam.gserviceaccount.com

# URLs
FRONTEND_URL=https://seudominio.com
API_URL=https://seudominio.com/api

# Segurança
JWT_SECRET=sua_jwt_secret_super_segura_aqui
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100